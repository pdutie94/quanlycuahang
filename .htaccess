RewriteEngine On

# Chặn index bởi search engine ở cấp HTTP header
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
</IfModule>

# Nếu URL đã bắt đầu bằng /public thì giữ nguyên
RewriteRule ^public/ - [L]

# Serve static/assets/uploads trực tiếp từ public
RewriteRule ^assets/(.*)$ public/assets/$1 [L]
RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

# Frontend root route must hit SPA shell (tranh index listing)
RewriteRule ^$ public/index.html [L]

# Nếu file/folder đã tồn tại ở root thì không rewrite
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# API: PHP (Slim) only
RewriteRule ^api(/.*)?$ public/index.php [L,QSA]

# Legacy system/auth paths -> SPA routes
RewriteRule ^logout$ /login [R=302,L]
RewriteRule ^migration$ /migrations [R=302,L]
RewriteRule ^user/changePasswordForm$ /change-password [R=302,L]
RewriteRule ^user/changePassword$ /change-password [R=302,L]
RewriteRule ^backup/database$ /migrations [R=302,L]

# Redirect legacy singular URLs sang frontend URLs mới
RewriteRule ^product$ /products [R=302,L]
RewriteRule ^customer$ /customers [R=302,L]
RewriteRule ^supplier$ /suppliers [R=302,L]
RewriteRule ^purchase$ /purchases [R=302,L]
RewriteRule ^category$ /categories [R=302,L]
RewriteRule ^unit$ /units [R=302,L]
RewriteRule ^report$ /reports [R=302,L]

# Frontend SPA routes (history mode) served as static file
RewriteRule ^(login|change-password|migrations|dashboard|products|customers|orders|pos|purchases|suppliers|categories|units|reports)(/.*)?$ public/index.html [L]

# Fallback an toàn cho các path frontend mới mở rộng
RewriteRule ^[A-Za-z0-9_-]+(/.*)?$ public/index.html [L]
