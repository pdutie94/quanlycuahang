RewriteEngine On

# Disable caching for all HTML responses (SPA shell)
Header always set Cache-Control "no-cache, no-store, must-revalidate" env=NO_CACHE
Header always set Pragma "no-cache" env=NO_CACHE
Header always set Expires "0" env=NO_CACHE

# Serve existing files/directories directly (MUST be before SPA rewrite)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# API only
RewriteRule ^api(/.*)?$ index.php [L,QSA]

# Legacy system/auth paths -> SPA routes
RewriteRule ^logout$ /login [R=302,L]
RewriteRule ^migration$ /migrations [R=302,L]
RewriteRule ^user/changePasswordForm$ /change-password [R=302,L]
RewriteRule ^user/changePassword$ /change-password [R=302,L]
RewriteRule ^backup/database$ /migrations [R=302,L]

# Backward-compatible redirects from legacy singular paths
RewriteRule ^product$ /products [R=302,L]
RewriteRule ^customer$ /customers [R=302,L]
RewriteRule ^supplier$ /suppliers [R=302,L]
RewriteRule ^purchase$ /purchases [R=302,L]
RewriteRule ^category$ /categories [R=302,L]
RewriteRule ^unit$ /units [R=302,L]
RewriteRule ^report$ /reports [R=302,L]

# Frontend root route must hit SPA shell
RewriteRule ^$ index.html [E=NO_CACHE:1,L]

# Vue SPA routes (history mode) served as static file
RewriteRule ^(login|change-password|migrations|dashboard|products|customers|orders|pos|purchases|suppliers|categories|units|reports)(/.*)?$ index.html [E=NO_CACHE:1,L]

# Fallback for new frontend routes
RewriteRule ^[A-Za-z0-9_-]+(/.*)?$ index.html [E=NO_CACHE:1,L]
