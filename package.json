{
  "name": "quanlycuahang",
  "private": true,
  "scripts": {
    "dev:spa": "vite",
    "build:spa": "vite build",
    "test:format": "node --experimental-strip-types --test frontend/src/shared/composables/useFormat.test.mts",
    "watch:spa": "npm run build:spa && chokidar \"frontend/src/**/*\" \"frontend/index.html\" \"vite.config.js\" -c \"npm run build:spa\"",
    "build:css": "tailwindcss -c tailwind.config.js -i resources/css/tailwind.css -o public/assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i resources/css/tailwind.css -o public/assets/css/tailwind.css --watch",
    "watch": "concurrently \"npm:watch:spa\" \"npm:watch:css\"",
    "build": "npm run build:css && npm run build:spa",
    "build-package": "bash build-package.sh",
    "build-full-package": "bash build-full-package.sh",
    "type-check": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "lucide-static": "^0.577.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vue-tsc": "^3.2.6"
  },
  "dependencies": {
    "@lucide/vue": "^1.8.0",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.15.0",
    "chart.js": "^4.5.1",
    "vue": "^3.5.32",
    "vue-router": "^4.6.3"
  }
}
